{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev && npx prisma generate && npx tsc -p tsconfig.build.json"
  },
  "deploy": {
    "preDeployCommand": "npx prisma db push",
    "startCommand": "node dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
